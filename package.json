{
  "name": "phone-bridge-cloud",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud-hosted multi-user Phone Bridge",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check public/dashboard.js && node --check agent/cloud-worker.js",
    "test": "npm run check",
    "agent": "node agent/cloud-worker.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  }
}
